# Copier vers .env (jamais commité). Voir docs/05-securite-confidentialite-v2.md §8.

NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (docker compose)
POSTGRES_USER=familyhub
POSTGRES_PASSWORD=familyhub
POSTGRES_DB=familyhub
POSTGRES_PORT=5432
DATABASE_URL=postgresql://familyhub:familyhub@localhost:5432/familyhub?schema=public

# MinIO (stockage objet privé, ADR-010)
MINIO_ROOT_USER=familyhub
MINIO_ROOT_PASSWORD=familyhub-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_BUCKET=family-hub
MINIO_USE_SSL=false

# Secret de session (à remplacer par une valeur longue en recette/prod)
SESSION_SECRET=change-me-in-local-only
