{
  "name": "family-hub",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "lint:arch": "pnpm --filter @family-hub/api lint:arch",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @family-hub/api start:dev",
    "dev:web": "pnpm --filter @family-hub/web dev",
    "prisma:generate": "pnpm --filter @family-hub/api prisma:generate",
    "prisma:migrate": "pnpm --filter @family-hub/api prisma:migrate"
  }
}
